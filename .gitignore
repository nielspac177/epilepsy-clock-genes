# data — referenced by checksum in config/traits_manifest.yaml, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# results (regenerated); keep pre-registration + lock files
results/*
!results/.gitkeep
!results/estimable_cells.tsv
!results/mr_power.tsv
!results/feasibility.tsv
!results/geneset_lock.json
!results/real_circadian_enrichment.tsv
!results/real_circadian_pergene_*.tsv

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# reference panels / binaries / downloaded tools
reference/
tools/
.snakemake/
*.zip
*.gz
!config/**/*.gz

# os / editor
.DS_Store
.ipynb_checkpoints/
