# Reproducible DAG: download -> munge -> gene/set + rg + MR -> Aim1/Aim3 -> report.
# `snakemake -s workflow/Snakefile -n` for a dry-run; drop -n to execute (synthetic by default).
#
# External binaries (real mode): MAGMA/LDSC/PLINK/GCTA/Rscript via environment.yml. When absent,
# the epicirc.* modules fall back to a deterministic SYNTHETIC path so the whole graph still runs.

import sys
import yaml

PY = sys.executable                       # the venv python running snakemake
RUN = f'PYTHONPATH=src "{PY}"'            # quoted: the repo path may contain spaces

with open("config/traits_manifest.yaml") as fh:
    MANIFEST = yaml.safe_load(fh)

EPILEPSY = list(MANIFEST["epilepsy"].keys())
CIRCADIAN = list(MANIFEST["circadian"].keys())
GENESETS = ["circadian_core", "negative_controls"]   # positive_control + GO ext = real-mode only

rule all:
    input:
        "results/geneset_lock.json",
        "results/estimable_cells.tsv",
        expand("results/magma/{gs}__{epi}.gsa.out", gs=GENESETS, epi=EPILEPSY),
        expand("results/ldsc/rg__{epi}__{circ}.log", epi=EPILEPSY, circ=CIRCADIAN),
        expand("results/mr/{circ}__{epi}.tsv", circ=CIRCADIAN, epi=EPILEPSY),
        "results/aim1_heterogeneity.tsv",
        "results/aim3_severity.tsv",
        "results/report.html",

# ---- pre-registration (before outcomes) ----
rule geneset_lock:
    output: "results/geneset_lock.json"
    shell: f"{RUN} -m epicirc.geneset.lock --config config/gene_sets --out {{output}}"

rule prereg_estimable:
    output: "results/estimable_cells.tsv"
    shell: f"{RUN} -m epicirc.stats.prereg --manifest config/traits_manifest.yaml --out {{output}}"

# ---- data layer ----
rule download:
    output: "data/raw/{dataset}.sumstats.gz"
    shell: f"{RUN} -m epicirc.data.download --dataset {{wildcards.dataset}} --manifest config/traits_manifest.yaml --out {{output}}"

rule munge:
    input: "data/raw/{dataset}.sumstats.gz"
    output: "data/processed/{dataset}.sumstats.gz"
    shell: f"{RUN} -m epicirc.data.munge --in {{input}} --out {{output}}"

# ---- Aim 1a: MAGMA gene + competitive gene-set ----
rule magma_gene:
    input: sumstats="data/processed/{epi}.sumstats.gz"
    output: "results/magma/{epi}.genes.raw"
    shell: f"{RUN} -m epicirc.magma.run_gene --sumstats {{input.sumstats}} --epi {{wildcards.epi}} --out {{output}}"

rule magma_geneset:
    input: genes="results/magma/{epi}.genes.raw"
    output: "results/magma/{gs}__{epi}.gsa.out"
    shell: f"{RUN} -m epicirc.magma.run_set --genes {{input.genes}} --set {{wildcards.gs}} --out {{output}}"

# ---- Aim 1c: LDSC genetic correlation (epilepsy x circadian trait) ----
rule ldsc_rg:
    input: a="data/processed/{epi}.sumstats.gz", b="data/processed/{circ}.sumstats.gz"
    output: "results/ldsc/rg__{epi}__{circ}.log"
    shell: f"{RUN} -m epicirc.ldsc.run_rg --a {{input.a}} --b {{input.b}} --out results/ldsc/rg__{{wildcards.epi}}__{{wildcards.circ}}"

# ---- Aim 2: two-sample MR (circadian exposure -> epilepsy outcome) ----
rule mr:
    input: exp="data/processed/{circ}.sumstats.gz", out="data/processed/{epi}.sumstats.gz"
    output: "results/mr/{circ}__{epi}.tsv"
    shell: f"{RUN} -m epicirc.mr.run --exposure {{input.exp}} --outcome {{input.out}} --out {{output}}"

# ---- Aim 1 synthesis: focal-vs-GGE heterogeneity + power-gated enrichment ----
rule aim1:
    input:
        est="results/estimable_cells.tsv",
        gsa=expand("results/magma/circadian_core__{epi}.gsa.out", epi=EPILEPSY),
        proc=expand("data/processed/{epi}.sumstats.gz", epi=EPILEPSY),
    output: "results/aim1_heterogeneity.tsv"
    shell: f"{RUN} -m epicirc.stats.run_aim1 --out {{output}}"

# ---- Aim 3: pharmacoresistance ----
rule aim3:
    input: "results/magma/circadian_core__drug_resistant_epilepsy.gsa.out"
    output: "results/aim3_severity.tsv"
    shell: f"{RUN} -m epicirc.stats.run_aim3 --out {{output}}"

# ---- report ----
rule report:
    input:
        "results/aim1_heterogeneity.tsv", "results/aim3_severity.tsv",
        "results/estimable_cells.tsv",
        expand("results/mr/{circ}__{epi}.tsv", circ=CIRCADIAN, epi=EPILEPSY),
    output: "results/report.html"
    shell: f"{RUN} -m epicirc.viz.report --results results --out {{output}}"
